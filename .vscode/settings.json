{
  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}/build/Debug",
    "--clang-tidy",
    "-header-insertion=iwyu"
  ],
  "cmake.buildDirectory": "${workspaceFolder}/build/${buildType}",
  "cmake.installPrefix": "${workspaceFolder}/install/${buildType}",
  "cmake.preferredGenerators": ["Ninja"],
  "cmake.configureSettings": {},
  "doxdocgen.generic.returnTemplate": "\\return ",
  "doxdocgen.generic.paramTemplate": "\\param[in] {param} ",
  "doxdocgen.c.firstLine": "/*!",
  "doxdocgen.c.factoryMethodText": "",
  "doxdocgen.c.getterText": "Get the {name}.",
  "doxdocgen.c.setterText": "Set the {name}.",
  "doxdocgen.c.triggerSequence": "/*!",
  "doxdocgen.cpp.ctorText": "Constructor.",
  "doxdocgen.cpp.dtorText": "Destructor.",
  "C_Cpp.intelliSenseEngine": "disabled",
  "C_Cpp.autocomplete": "disabled",
  "C_Cpp.errorSquiggles": "disabled",
  "restructuredtext.linter.disabledLinters": ["rstcheck", "rst-lint"],
  "esbonio.server.enabled": false,
  "files.watcherExclude": {
    "**/.benchmarks/**": true,
    "**/.jupyter_cache/**": true,
    "**/.mypy_cache/**": true,
    "**/.pytest_cache/**": true,
    "**/.venv/**": true,
    "**/build/**": true
  },
  "cSpell.enabledFileTypes": {
    "cmake": true,
    "plantuml": true,
    "shellscript": true,
    "toml": true
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "always"
    }
  },
  "cmake.useCMakePresets": "never",
  "restructuredtext.pythonRecommendation.disabled": true,
  "cmake.loadCompileCommands": false,
  "python-envs.defaultEnvManager": "ms-python.python:poetry",
  "python-envs.defaultPackageManager": "ms-python.python:poetry",
  "cmake.modifyLists.addNewSourceFiles": "no",
  "cmake.modifyLists.removeDeletedSourceFiles": "no",
  "better-todo-tree.filtering.ignoreGitSubmodules": true
}
