#:import FONT_SIZE_HEADER2 func_sketch._gui.common.constants.FONT_SIZE_HEADER2
#:import SPACING_DEFAULT func_sketch._gui.common.constants.SPACING_DEFAULT

#:include common/error_message_label.kv

<CurveSpecWidget>:
    orientation: "vertical"
    size_hint_y: None
    height: self.minimum_height
    spacing: SPACING_DEFAULT
    BoxLayout:
        orientation: "horizontal"
        size_hint_y: None
        height: self.minimum_height
        spacing: SPACING_DEFAULT
        Label:
            text: root._model.curve_name
            size_hint_y: None
            height: self.texture_size[1]
            font_size: FONT_SIZE_HEADER2
            halign: "left"
            text_size: self.width, None
        Label:
            canvas.before:
                Color:
                    rgba: root._model.curve_color_as_rgba
                Rectangle:
                    pos: self.pos
                    size: self.size
            size_hint_x: None
            width: FONT_SIZE_HEADER2
            size_hint_y: None
            height: FONT_SIZE_HEADER2
    BoxLayout:
        id: curve_spec_details_layout
        orientation: "vertical"
        size_hint_y: None
        height: self.minimum_height
    ErrorMessageLabel:
        text: root._model.error_message
