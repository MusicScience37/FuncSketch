@startuml classes_python

package func_sketch {
    package _cpp {
        class Expression

        class ExpressionParser {
            + __call__(expression_str: str) : Expression
        }
        ExpressionParser ..> Expression

        class RGBColor {
            + r : int
            + g : int
            + b : int
        }

        class Point {
            + x : float
            + y : float
        }

        class ParameterizedPoint {
            + t : float
            + x : float
            + y : float
        }

        class PointList {
            + points : List[Point]
        }
        PointList ..> Point

        class PlotRange {
            + x_range : tuple[float, float]
            + y_range : tuple[float, float]
        }

        class PlotConfig

        class ExplicitCurveSpec {
            + name : str
            + function_expression_str : str
            + color : RGBColor
        }
        ExplicitCurveSpec o-- RGBColor

        class SampledExplicitCurve {
            + name : str
            + points : List[Point]
            + color : RGBColor
        }
        SampledExplicitCurve ..> Point
        SampledExplicitCurve o-- RGBColor

        class ParameterizedCurveSpec {
            + name : str
            + x_expression_str : str
            + y_expression_str : str
            + parameter_range : tuple[float, float]
            + color : RGBColor
        }
        ParameterizedCurveSpec o-- RGBColor

        class SampledParameterizedCurve {
            + name : str
            + points : List[ParameterizedPoint]
            + color : RGBColor
        }
        SampledParameterizedCurve ..> ParameterizedPoint
        SampledParameterizedCurve o-- RGBColor

        class CurveSampler {
            + __init__(range: PlotRange, config: PlotConfig)
            + range : PlotRange
            + config : PlotConfig
            + __call__(spec: ExplicitCurveSpec) : SampledExplicitCurve
            + __call__(spec: ParameterizedCurveSpec) : SampledParameterizedCurve
        }
        CurveSampler o-- ExpressionParser
        CurveSampler ..> ExplicitCurveSpec
        CurveSampler ..> SampledExplicitCurve
        CurveSampler ..> ParameterizedCurveSpec
        CurveSampler ..> SampledParameterizedCurve

        class Plotter {
            + __init__(range: PlotRange, config: PlotConfig)
            + range : PlotRange
            + config : PlotConfig
            + write(sampled_curves: list[SampledExplicitCurve | SampledParameterizedCurve], image: numpy.ndarray)
        }
        Plotter o-- PlotRange
        Plotter o-- PlotConfig
        Plotter ..> SampledExplicitCurve
        Plotter ..> SampledParameterizedCurve
        Plotter ..> RGBColor
    }
}

@enduml
