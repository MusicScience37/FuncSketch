@startuml classes_cpp

package func_sketch {
    class Real <<typedef>> {
        using Real = double
    }

    class Complex <<typedef>> {
        using Complex = std::complex<double>
    }

    class Integer <<typedef>> {
        using Integer = int32_t
    }

    class Number <<typedef>> {
        using Number = std::variant<Integer, Real, Complex>
    }

    enum ParameterType {
        x
        s
        t
    }

    struct Point {
        + x : Real
        + y : Real
    }

    struct ParameterizedPoint {
        + t : Real
        + x : Real
        + y : Real
    }

    package utilities {
        class Any {
            + Any(object : T)
            + get<T>() : const T&
        }
    }

    package math {
        class UnaryOperator {
            + operator()(arg : Number, result : Number&)
        }
        UnaryOperator o-- Any

        class BinaryOperator {
            + operator()(left : Number, right : Number, result : Number&)
        }
        BinaryOperator o-- Any

        class MathFunction {
            + operator()(args : std::vector<Number>, result : Number&)
        }
        MathFunction o-- Any

        class MathFunctionList {
            + emplace(function : MathFunction)
            + get(name : std::string) : std::optional<MathFunction>
        }
        MathFunctionList o-- MathFunction

        class ConstantList {
            + emplace(name : std::string, value : Number)
            + get(name : std::string) : std::optional<Number>
        }

        note as math_functions_note
            Actual mathematical functions and operators
            are implemented here too.
        end note
    }

    package expressions {
        class Expression {
            - expression_ : std::variant<ConstantExpression, ParameterExpression, UnaryExpression, BinaryExpression, FunctionCallExpression, OperationCallExpression>
        }

        struct ConstantExpression {
            + value : Number
        }
        Expression <..> ConstantExpression

        struct ParameterExpression {
            + type : ParameterType
        }
        Expression <..> ParameterExpression
        ParameterExpression o-- ParameterType

        struct UnaryExpression {
            + target : const Expression*
            + operator_object : UnaryOperator
        }
        Expression <..> UnaryExpression
        UnaryExpression o-- UnaryOperator

        struct BinaryExpression {
            + left : const Expression*
            + right : const Expression*
            + operator_object : BinaryOperator
        }
        Expression <..> BinaryExpression
        BinaryExpression o-- BinaryOperator

        struct FunctionCallExpression {
            + arguments : std::vector<const Expression*>
            + function : MathFunction
        }
        Expression <..> FunctionCallExpression
        FunctionCallExpression o-- MathFunction

        class MathOperation {
            + operator()(args : std::vector<const Expression*>, evaluator : ExpressionEvaluator, parameters : ParameterValueDict, result : Number&)
        }
        note right
            MathOperation is placed in the expressions namespace
            because it depends on expressions.
        end note
        MathOperation o-- Any
        MathOperation .up.> Expression
        MathOperation .up.> ExpressionEvaluator
        MathOperation .up.> ParameterValueDict

        class MathOperationList {
            + emplace(operation : MathOperation)
            + get(name : std::string) : std::optional<MathOperation>
        }
        MathOperationList o-- MathOperation

        struct OperationCallExpression {
            + arguments : std::vector<const Expression*>
            + operation : MathOperation
        }
        Expression <..> OperationCallExpression
        OperationCallExpression o-- MathOperation

        class ExpressionMemoryPool {
            + create<T>(args...) : const Expression*
        }
        ExpressionMemoryPool ..> Expression

        class ParameterValueDict {
            + operator[](type : ParameterType) : MutableParameterProxy
            + operator[](type : ParameterType) const : const std::optional<Number>&
        }
        ParameterValueDict ..> ParameterType

        class ExpressionEvaluator {
            + operator()(expression : const Expression&, parameters : const ParameterValueDict&, result : Number&)
            + operator()(expression : const Expression&, parameters : const ParameterValueDict&, result : Real&)
        }
        ExpressionEvaluator ..> ParameterValueDict

        class ExpressionPtr
        ExpressionPtr o-- Expression
        ExpressionPtr o-- ExpressionMemoryPool
    }

    package parser {
        class ExpressionParser {
            + operator()(expression_str : std::string) : ExpressionPtr
        }
        ExpressionParser o-- MathFunctionList
        ExpressionParser o-- MathOperationList
        ExpressionParser o-- ConstantList
        ExpressionParser ..> ExpressionPtr
    }

    package sampling {
        class SamplingConfig

        class PointSampler<PointType> {
            + range(value : PlotRange)
            + config(value : SamplingConfig)
            + operator()(function : std::function<PointType(Real)>, parameter_range : std::pair<Real, Real>) : std::vector<PointType>
        }
        PointSampler o-- SamplingConfig
        PointSampler ..> Point
        PointSampler ..> ParameterizedPoint
    }

    package plotter {
        struct RGBColor {
            + r : uint8_t
            + g : uint8_t
            + b : uint8_t
        }

        class Image <<typedef>> {
            using Image = cv::Mat
        }

        class PlotRange {
            + x_range() : std::pair<Real, Real>
            + y_range() : std::pair<Real, Real>
        }
        PointSampler o-- PlotRange

        struct PlotConfig

        class Plotter {
            + range(value : PlotRange)
            + config(value : PlotConfig)
            + write(sampled_curves : std::vector<SampledCurve>, image : Image&)
        }
        Plotter o-- PlotRange
        Plotter o-- PlotConfig
        Plotter ..> RGBColor
        Plotter ..> Image
    }

    package curves {
        struct ExplicitCurveSpec {
            + name : std::string
            + function_expression_str : std::string
            + color : RGBColor
        }
        ExplicitCurveSpec o-- RGBColor

        struct SampledExplicitCurve {
            + name : std::string
            + points : std::vector<Point>
            + color : RGBColor
        }
        SampledExplicitCurve ..> Point
        SampledExplicitCurve o-- RGBColor

        struct ParameterizedCurveSpec {
            + name : std::string
            + x_expression_str : std::string
            + y_expression_str : std::string
            + parameter_range : std::pair<Real, Real>
            + color : RGBColor
        }
        ParameterizedCurveSpec o-- RGBColor

        struct SampledParameterizedCurve {
            + name : std::string
            + points : std::vector<ParameterizedPoint>
            + color : RGBColor
        }
        SampledParameterizedCurve ..> ParameterizedPoint
        SampledParameterizedCurve o-- RGBColor

        class SampledCurve <<typedef>> {
            using SampledCurve = std::variant<SampledExplicitCurve, SampledParameterizedCurve>
        }
        SampledCurve ..> SampledExplicitCurve
        SampledCurve ..> SampledParameterizedCurve

        class CurveSampler {
            + range(value : PlotRange)
            + config(value : PlotConfig)
            + operator()(spec : ExplicitCurveSpec) : SampledExplicitCurve
            + operator()(spec : ParameterizedCurveSpec) : SampledParameterizedCurve
        }
        CurveSampler o-- ExpressionParser
        CurveSampler o-- ExpressionEvaluator
        CurveSampler o-- PointSampler
        CurveSampler ..> ExplicitCurveSpec
        CurveSampler ..> SampledExplicitCurve
        CurveSampler ..> ParameterizedCurveSpec
        CurveSampler ..> SampledParameterizedCurve
    }
    Plotter ..> SampledCurve
}

@enduml
